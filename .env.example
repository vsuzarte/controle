# Copie para ".env" e ajuste. O arquivo .env não vai para o git.

# Senha para entrar no sistema (recomendado, já que fica acessível na rede de casa).
# Deixe vazio para não pedir senha.
SENHA=troque-esta-senha

# Porta no PC. Acesse http://localhost:8080 ou http://IP-DO-PC:8080 no celular.
PORTA=8080
